<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only, against the system trust store (Android 14+ updates its CA store through a Mainline
  module, so no roots are bundled). Passwords and tokens never travel over http://.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
